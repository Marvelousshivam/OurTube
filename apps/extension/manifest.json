{
  "manifest_version": 3,
  "name": "OurTube Companion Extension",
  "version": "1.0.0",
  "description": "High-fidelity YouTube Music companion for OurTube. Unlocks zero-CORS InnerTube requests, direct audio/video streaming, and Google account authentication.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "declarativeNetRequest",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://ourtube-zeta.vercel.app/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://mobileservice.kugou.com/*",
    "https://lyrics.kugou.com/*",
    "https://apic.musixmatch.com/*",
    "https://www.musixmatch.com/*",
    "https://genius.com/*",
    "https://music.apple.com/*",
    "https://amp-api.music.apple.com/*",
    "https://api.paxsenix.org/*",
    "https://lyrics-api.boidu.dev/*",
    "https://unison.boidu.dev/*"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://ourtube-zeta.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://ourtube-zeta.vercel.app/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "action": {
    "default_title": "OurTube Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
